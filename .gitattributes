# Fins de ligne : texte en LF dans le dépôt (les fichiers restent LF sur Windows).
* text=auto eol=lf

# Binaires explicites : jamais de conversion.
*.t3d binary
*.wasm binary
*.png binary
*.jpg binary
*.wav binary

# Code tiers (chibicc) : tel quel, aucune conversion.
cc/chibicc/** -text

# Licences tierces conservées telles quelles, espaces de fin compris.
cc/include/ui_font_OFL.txt -whitespace
cc/include/ui_sans_OFL.txt -whitespace
cc/third_party/lodepng/LICENSE -whitespace
