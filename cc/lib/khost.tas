; khost.tas — services de base du NOYAU (mode -1) : accès direct au matériel.
.align 3
putchar:
  stt a0, -1(zero)
  ret
exit:
  halt
abort:
  halt
__builtin_tmin:
  min a0, a0, a1
  ret
__builtin_tmax:
  max a0, a0, a1
  ret
__builtin_tmul:
  tmul a0, a0, a1
  ret
__builtin_sht:
  sht a0, a0, a1
  ret
