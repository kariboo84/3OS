; fact.tas — factorielle RÉCURSIVE de 1 à 15 (pile, call/ret, push/pop)
; Affiche n! en décimal (ecall 2) et en trits équilibrés (ecall 3).
; 15! = 1 307 674 368 000 tient dans un mot de 27 trits (max ±3,8·10^12).

start:  li    s1, 1             ; s1 = n (registre sauvegardé)
        li    s2, 15
next:   mv    a0, s1
        ecall 2                 ; n
        la    a0, s_fact
        call  puts              ; "! = "
        mv    a0, s1
        call  fact              ; a0 = n!
        mv    s3, a0
        ecall 2                 ; décimal
        la    a0, s_eq
        call  puts              ; "  = 0t"
        mv    a0, s3
        ecall 3                 ; trits
        li    a0, 10
        ecall 1
        addi  s1, s1, 1
        ble   s1, s2, next
        li    a0, 0
        ecall 0

; fact(a0) -> a0 ; récursif : fact(n) = n * fact(n-1), fact(0) = 1
fact:   bgtz  a0, rec
        li    a0, 1
        ret
rec:    push  ra
        push  a0
        addi  a0, a0, -1
        call  fact
        pop   t0                ; t0 = n
        mul   a0, a0, t0
        pop   ra
        ret

; puts(a0) : chaîne terminée par 0, via ecall 1
puts:   mv    t0, a0
p_lp:   ldt   a0, 0(t0)
        beqz  a0, p_end
        ecall 1
        addi  t0, t0, 1
        j     p_lp
p_end:  ret

s_fact: .str  "! = "
s_eq:   .str  "  = 0t"
